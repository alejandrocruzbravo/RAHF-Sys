<link rel="stylesheet" href="/styles/dsh-gestor.styles.css">

<section class="container">
    <div class="is-flex">
        <label for="" class="is-size-7-mobile is-size-6-tablet is-size-6-desktop is-size-6-fullhd">Gestores</label>
        <label for="" class="is-size-7-mobile is-size-6-tablet is-size-6-desktop is-size-6-fullhd ml-auto">Instituto
            Tecnológico de Chetumal</label>
    </div>

    <div class="container is-flex mt-3 p-2">
        <div>
            <form action="" class="is-flex">
                <input type="text" name="" id="" placeholder="Buscar gestor" class="input">
                <input type="submit" value="Buscar" class="button">
            </form>
        </div>
        <div class="ml-auto">
            <button class="button is-primary open-modal" data-target="modal-rsg-new">Nuevo Gestor</button>
            <button class="button is-link open-modal">
                <i class="fa-solid fa-print mr-1" style="color: #ffffff;"></i>
                Reporte
            </button>
        </div>
        <div class="modal" id="modal-rsg-new">
            <div class="modal-background"></div>
            <div class="modal-card">
                <header class="modal-card-head">
                    <p class="modal-card-title">Nuevo Gestor</p>
                    <button class="delete close-modal" aria-label="close"></button>
                </header>
                <section class="modal-card-body">
                    <form action="">
                        <div class="field">
                            <label class="label">Nombre</label>
                            <div class="control">
                                <input class="input" type="text" placeholder="Nombre">
                            </div>
                        </div>
                        <div class="field">
                            <label class="label">Apellidos</label>
                            <div class="control">
                                <input class="input" type="text" placeholder="Apellido">
                            </div>
                        </div>
                        <div class="field">
                            <label class="label">Puesto/Cargo</label>
                            <div class="control">
                                <div class="select">
                                    <select>
                                        <option>Selecione puesto/cargo</option>
                                        <option>Opcion 1</option>
                                        <option>Opcion 2</option>
                                        <option>Opcion 3</option>
                                        <option>Opcion 4</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <label class="label">Área</label>
                            <div class="control">
                                <div class="select">
                                    <select>
                                        <option>Seleccionar Área</option>
                                        <option>RR.HH</option>
                                        <option>Sistemas</option>
                                        <option>Administración</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <label class="label">Departamento</label>
                            <div class="control">
                                <div class="select">
                                    <select>
                                        <option>Seleccionar Departamento</option>
                                        <option>RR.HH</option>
                                        <option>Sistemas</option>
                                        <option>Administración</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="field">
                            <label class="label">Correo</label>
                            <div class="control">
                                <input class="input" type="email" placeholder="Correo">
                            </div>
                        </div>
                        <div class="field">
                            <label class="label">Número Teléfono</label>
                            <div class="control">
                                <input class="input" type="text" placeholder="Número">
                            </div>
                        </div>
                        <div class="field">
                            <label class="label">Rol</label>
                            <div class="control">
                                <div class="select">
                                    <select>
                                        <option>Seleccionar rol</option>
                                        <option>Administrador</option>
                                        <option>Gestor</option>
                                        <option>Jefe de departamento</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </form>
                </section>
                <footer class="modal-card-foot">
                    <button class="button is-primary">Continuar</button>
                </footer>
            </div>
        </div>
    </div>

    <!-- Modal de Editar -->
    <div class="modal" id="modal-edit">
        <div class="modal-background"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p class="modal-card-title">Editar Gestor</p>
                <button class="delete close-modal" aria-label="close"></button>
            </header>
            <section class="modal-card-body">
                <form action="">
                    <div class="field">
                        <label class="label">Puesto/Cargo</label>
                        <div class="control">
                            <div class="select">
                                <select id="edit-puesto">
                                    <option>Selecione puesto/cargo</option>
                                    <option>Director de TI</option>
                                    <option>Coordinador RH</option>
                                    <option>Jefe de Personal</option>
                                    <option>Analista de Sistemas</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="field">
                        <label class="label">Área</label>
                        <div class="control">
                            <div class="select">
                                <select id="edit-area">
                                    <option>Seleccionar Área</option>
                                    <option>RR.HH</option>
                                    <option>Sistemas</option>
                                    <option>Administración</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="field">
                        <label class="label">Departamento</label>
                        <div class="control">
                            <div class="select">
                                <select id="edit-departamento">
                                    <option>Seleccionar Departamento</option>
                                    <option>RR.HH</option>
                                    <option>Sistemas</option>
                                    <option>Administración</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="field">
                        <label class="label">Correo</label>
                        <div class="control">
                            <input class="input" type="email" id="edit-correo" placeholder="Correo">
                        </div>
                    </div>
                    <div class="field">
                        <label class="label">Rol</label>
                        <div class="control">
                            <div class="select">
                                <select id="edit-rol">
                                    <option>Seleccionar rol</option>
                                    <option>Administrador</option>
                                    <option>Gestor</option>
                                    <option>Jefe de departamento</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </section>
            <footer class="modal-card-foot">
                <button class="button is-primary">Guardar Cambios</button>
                <button class="button close-modal">Cancelar</button>
            </footer>
        </div>
    </div>

    <!-- Modal de Eliminar -->
    <div class="modal" id="modal-delete">
        <div class="modal-background"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p class="modal-card-title">Confirmar Eliminación</p>
                <button class="delete close-modal" aria-label="close"></button>
            </header>
            <section class="modal-card-body">
                <p>¿Estás seguro que deseas eliminar este gestor? Esta acción no se puede deshacer.</p>
                <div class="mt-4">
                    <p><strong>Nombre: </strong><span id="delete-nombre"></span></p>
                    <p><strong>Cargo: </strong><span id="delete-cargo"></span></p>
                    <p><strong>Departamento: </strong><span id="delete-departamento"></span></p>
                </div>
            </section>
            <footer class="modal-card-foot">
                <button class="button is-danger">Eliminar</button>
                <button class="button close-modal">Cancelar</button>
            </footer>
        </div>
    </div>

