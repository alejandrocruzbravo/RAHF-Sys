    <!-- Script para manejar los modales -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Abrir modales
            document.querySelectorAll('.view-area, .edit-area, .delete-area').forEach(button => {
                button.addEventListener('click', () => {
                    const target = button.getAttribute('data-target');
                    document.getElementById(target).classList.add('is-active');
                });
            });

            // Cerrar modales
            document.querySelectorAll('.close-modal').forEach(button => {
                button.addEventListener('click', () => {
                    button.closest('.modal').classList.remove('is-active');
                });
            });

            // Cerrar modal al hacer clic en el fondo
            document.querySelectorAll('.modal-background').forEach(background => {
                background.addEventListener('click', () => {
                    background.closest('.modal').classList.remove('is-active');
                });
            });
        });
    </script>
