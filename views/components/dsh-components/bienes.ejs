                                            <option>Equipo de computo</option>
                                            <option>Jardinería</option>
                                            <option>Limpieza</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="field">
                                <label class="label">Numero de bienes</label>
                                <div class="control">
                                    <input class="input" type="text" value="1">
                                </div>
                            </div>
