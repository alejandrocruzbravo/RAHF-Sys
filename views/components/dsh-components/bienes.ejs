                                            <option>RR.HH</option>
                                            <option>Sistemas</option>
                                            <option>Administración</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="field">
                                <label class="label">Categoria</label>
                                <div class="control">
