<link rel="stylesheet" href="/styles/solicitudes.styles.css">

<div class="box">
    <div class="level">
        <div class="level-left">
            <h2 class="title is-4">Solicitudes</h2>
        </div>
        <div class="level-right">
            <div class="buttons has-addons">
                <button class="button is-small" data-filtro="recientes">Más Recientes</button>
                <button class="button is-small" data-filtro="antiguas">Más Antiguas</button>
            </div>
        </div>
    </div>

    <div class="solicitudes-list">
        <!-- Ejemplo de una solicitud -->
        <div class="box">
            <div class="level is-mobile">
                <div class="level-left">
                    <div class="level-item">
                        <div>
                            <h3 class="subtitle is-5">Nueva Solicitud</h3>
                            <p class="has-text-grey is-size-7">Hace 5 minutos</p>
                        </div>
                    </div>
                </div>
                <div class="level-right">
                    <div class="level-item">
                        <span class="tag is-warning is-light">Pendiente</span>
                        <button class="button is-small is-dark ml-2">Detalles</button>
                    </div>
                </div>
            </div>
            <div class="content">
                <p>Usuario: Juan Pérez</p>
                <p>Tipo: Solicitud de intercambio de bien</p>
            </div>
            <div class="buttons">
                <button class="button is-small is-success">Aceptar</button>
                <button class="button is-small is-danger">Rechazar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de detalles -->
<div class="modal" id="modalDetalles">
    <div class="modal-background"></div>
    <div class="modal-card is-large">
        <header class="modal-card-head">
            <p class="modal-card-title">Detalles de la Solicitud</p>
            <button class="delete" aria-label="close"></button>
        </header>
        <section class="modal-card-body">
            <div class="columns">
                <div class="column">
                    <div class="box">
                        <h4 class="title is-5">Información del Bien</h4>
                        <div class="content">
                            <p><strong>Nombre del Bien:</strong> Computadora HP</p>
                            <p><strong>Descripción:</strong> Laptop HP ProBook 450 G8, Intel Core i5, 8GB RAM</p>
                            <p><strong>Estado:</strong> Bueno</p>
                            <p><strong>Número de Inventario:</strong> INV-2023-001</p>
                        </div>
                    </div>
                </div>
                <div class="column">
                    <div class="box">
                        <h4 class="title is-5">Origen</h4>
                        <div class="content">
                            <p><strong>Área Actual:</strong> Departamento de Sistemas</p>
                            <p><strong>Responsable Actual:</strong> María González</p>
                            <p><strong>Ubicación:</strong> Edificio A, Piso 3, Oficina 302</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="columns">
                <div class="column">
                    <div class="box">
                        <h4 class="title is-5">Destino</h4>
                        <div class="content">
                            <p><strong>Área Destino:</strong> Departamento de Contabilidad</p>
                            <p><strong>Responsable Destino:</strong> Carlos Rodríguez</p>
                            <p><strong>Ubicación:</strong> Edificio B, Piso 2, Oficina 205</p>
                        </div>
                    </div>
                </div>
                <div class="column">
                    <div class="box">
                        <h4 class="title is-5">Motivo del Intercambio</h4>
                        <div class="content">
                            <p>Necesidad de equipo para nuevo personal en el área de contabilidad. El equipo actual del departamento de sistemas será reemplazado por uno nuevo, por lo que se propone reutilizar este equipo en contabilidad.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<script src="/scripts/solicitudes.scripts.js"></script>


